<Window x:Class="SoFresh.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:converters="clr-namespace:SoFresh.App.Converters"
        xmlns:controls="clr-namespace:SoFresh.App.Controls"
        mc:Ignorable="d"
        Title="SoFresh"
        Width="1480"
        Height="920"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Language="en-US"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:BytesToReadableSizeConverter x:Key="BytesToReadableSizeConverter" />
        <converters:ResourceKeyToBrushConverter x:Key="ResourceKeyToBrushConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <HierarchicalDataTemplate x:Key="FileTreeNodeTemplate" ItemsSource="{Binding Children}">
            <Grid ToolTip="{Binding FullPath}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Style="{StaticResource IconGlyphStyle}"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="12"
                           Text="{Binding IconGlyph}" />
                <TextBlock Grid.Column="1"
                           Margin="4,0,10,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Text="{Binding Name}" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionStyle}"
                           FontSize="9"
                           Text="{Binding Detail}" />
            </Grid>
        </HierarchicalDataTemplate>

        <DataTemplate x:Key="TreemapCellTemplate">
            <Border Margin="3"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    ClipToBounds="True"
                    ToolTip="{Binding Detail}">
                <Grid>
                    <Border Background="{Binding BrushResourceKey, Converter={StaticResource ResourceKeyToBrushConverter}}"
                            Opacity="0.25" />
                    <Path Margin="0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Bottom"
                          Data="M0,28 C40,5 90,48 145,15 C200,-15 245,24 310,0 L310,80 L0,80 Z"
                          Fill="{Binding BrushResourceKey, Converter={StaticResource ResourceKeyToBrushConverter}}"
                          Opacity="0.10"
                          Stretch="Fill" />
                    <StackPanel Margin="14" VerticalAlignment="Bottom">
                        <TextBlock FontFamily="{DynamicResource IconFont}"
                                   FontSize="16"
                                   Foreground="{Binding BrushResourceKey, Converter={StaticResource ResourceKeyToBrushConverter}}"
                                   Text="{Binding IconGlyph}" />
                        <TextBlock Margin="0,7,0,0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="{Binding Name}" />
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Text="{Binding Detail}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="TreemapSlotStyle" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource TreemapCellTemplate}" />
            <Style.Triggers>
                <Trigger Property="Content" Value="{x:Null}">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="{DynamicResource TitleBarHeight}" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0"
                  Background="{DynamicResource SidebarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{DynamicResource SidebarWidth}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Width="27"
                            Height="27"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="8">
                        <TextBlock Style="{StaticResource IconGlyphStyle}"
                                   Foreground="#07120E"
                                   FontSize="15"
                                   Text="&#xE74D;" />
                    </Border>
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource DisplayFont}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="SoFresh" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="22,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               Text="OVERVIEW" />
                    <Border Margin="10,0,0,0"
                            Padding="7,3"
                            Background="{DynamicResource AccentTintBrush}"
                            CornerRadius="9">
                        <TextBlock Foreground="{DynamicResource AccentBrush}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Text="READ-ONLY PREVIEW" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button AutomationProperties.Name="Minimize"
                            Click="MinimizeButton_Click"
                            Style="{StaticResource WindowCaptionButtonStyle}"
                            ToolTip="Minimize"
                            Content="&#xE921;" />
                    <Button x:Name="MaximizeButton"
                            AutomationProperties.Name="Maximize"
                            Click="MaximizeButton_Click"
                            Style="{StaticResource WindowCaptionButtonStyle}"
                            ToolTip="Maximize"
                            Content="&#xE922;" />
                    <Button AutomationProperties.Name="Close"
                            Click="CloseButton_Click"
                            Style="{StaticResource CloseCaptionButtonStyle}"
                            ToolTip="Close"
                            Content="&#xE8BB;" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{DynamicResource SidebarWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,1,1,0">
                    <Grid Margin="0,12,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Margin="20,8,20,8"
                                   Style="{StaticResource LabelStyle}"
                                   Text="EXPLORE" />

                        <StackPanel Grid.Row="1">
                            <Button AutomationProperties.Name="Dashboard"
                                    Style="{StaticResource NavButtonStyle}"
                                    Tag="Selected">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource IconGlyphStyle}" Text="&#xE80F;" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="Dashboard" />
                                </Grid>
                            </Button>
                            <Button AutomationProperties.Name="Scan"
                                    Command="{Binding BrowseFolderCommand}"
                                    Style="{StaticResource NavButtonStyle}"
                                    ToolTip="Choose a folder to scan">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource IconGlyphStyle}" Text="&#xE721;" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Text="Scan" />
                                </Grid>
                            </Button>
                            <Button AutomationProperties.Name="File tree"
                                    Command="{Binding ShowTreeCommand}"
                                    Style="{StaticResource NavButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource IconGlyphStyle}" Text="&#xED41;" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Text="File tree" />
                                </Grid>
                            </Button>
                            <Button AutomationProperties.Name="Large files"
                                    IsEnabled="False"
                                    Style="{StaticResource NavButtonStyle}"
                                    ToolTip="Dedicated view coming soon; results already appear on the dashboard"
                                    ToolTipService.ShowOnDisabled="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource IconGlyphStyle}" Text="&#xEDA2;" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Text="Large files" />
                                    <Border Grid.Column="2" Style="{StaticResource PillStyle}" Padding="7,2">
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Text="{Binding LargeFiles.Count}" />
                                    </Border>
                                </Grid>
                            </Button>
                            <Button AutomationProperties.Name="Duplicates"
                                    IsEnabled="False"
                                    Style="{StaticResource NavButtonStyle}"
                                    ToolTip="Dedicated view coming soon; the count already appears on the dashboard"
                                    ToolTipService.ShowOnDisabled="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource IconGlyphStyle}" Text="&#xE8B7;" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Text="Duplicates" />
                                    <Border Grid.Column="2" Style="{StaticResource PillStyle}" Padding="7,2">
                                        <TextBlock Foreground="{DynamicResource PurpleBrush}" FontSize="10" Text="{Binding DuplicateCountLabel}" />
                                    </Border>
                                </Grid>
                            </Button>
                            <Button AutomationProperties.Name="Organize"
                                    IsEnabled="False"
                                    Style="{StaticResource NavButtonStyle}"
                                    ToolTip="Coming soon: organization preview"
                                    ToolTipService.ShowOnDisabled="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource IconGlyphStyle}" Text="&#xE8B7;" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Text="Organize" />
                                </Grid>
                            </Button>

                            <Separator Margin="20,17,20,13" />
                            <TextBlock Margin="20,0,20,8" Style="{StaticResource LabelStyle}" Text="MANAGE" />

                            <Button AutomationProperties.Name="Quarantine"
                                    IsEnabled="False"
                                    Style="{StaticResource NavButtonStyle}"
                                    ToolTip="Coming soon: reversible quarantine"
                                    ToolTipService.ShowOnDisabled="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource IconGlyphStyle}" Text="&#xE7BA;" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Text="Quarantine" />
                                </Grid>
                            </Button>
                            <Button AutomationProperties.Name="History"
                                    IsEnabled="False"
                                    Style="{StaticResource NavButtonStyle}"
                                    ToolTip="Coming soon: operation history"
                                    ToolTipService.ShowOnDisabled="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource IconGlyphStyle}" Text="&#xE81C;" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Text="History" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="16,0">
                            <Border Padding="12"
                                    Background="{DynamicResource AccentTintBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" Background="{DynamicResource AccentBrush}" CornerRadius="8">
                                        <TextBlock Style="{StaticResource IconGlyphStyle}" Foreground="#07120E" FontSize="13" Text="&#xE73E;" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Read-only preview" />
                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionStyle}" Text="No files are deleted" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Button Margin="0,8,0,0"
                                    AutomationProperties.Name="Settings"
                                    IsEnabled="False"
                                    Style="{StaticResource NavButtonStyle}"
                                    ToolTip="Settings will be available in a future release"
                                    ToolTipService.ShowOnDisabled="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource IconGlyphStyle}" Text="&#xE713;" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Text="Settings" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main area -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="82" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource WindowBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="28,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding Greeting}" />
                                    <TextBlock Margin="7,0,0,0" Style="{StaticResource PageTitleStyle}" Foreground="{DynamicResource AccentBrush}" Text="{Binding DisplayName, StringFormat={}{0}.}" />
                                </StackPanel>
                                <StackPanel Margin="1,3,0,0" Orientation="Horizontal">
                                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Text="{Binding TodayLabel}" />
                                    <TextBlock Margin="8,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Text="·" />
                                    <TextBlock MaxWidth="360"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12"
                                               Text="{Binding SelectedRootLabel}"
                                               ToolTip="{Binding SelectedRootLabel}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <Grid Width="250" Margin="0,0,10,0">
                                    <TextBox x:Name="SearchBox"
                                             Padding="36,8,36,8"
                                             AutomationProperties.HelpText="Filter the table by name, path, category, or risk"
                                             AutomationProperties.Name="Search dashboard"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="12,0,0,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Style="{StaticResource IconGlyphStyle}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="&#xE721;" />
                                    <TextBlock Margin="36,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="12"
                                               Text="Search files, categories, paths…">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSearchText}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Width="30"
                                            Height="30"
                                            Margin="0,0,3,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Clear search"
                                            Command="{Binding ClearSearchCommand}"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="Clear search"
                                            Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Style="{StaticResource IconGlyphStyle}" FontSize="11" Text="&#xE894;" />
                                    </Button>
                                </Grid>

                                <Button Margin="0,0,8,0"
                                        AutomationProperties.HelpText="Choose the scope of the next scan"
                                        AutomationProperties.Name="Choose folder"
                                        Command="{Binding BrowseFolderCommand}"
                                        ToolTip="Choose a folder to scan">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,7,0" Style="{StaticResource IconGlyphStyle}" FontSize="14" Text="&#xE8B7;" />
                                        <TextBlock VerticalAlignment="Center" Text="Folder" />
                                    </StackPanel>
                                </Button>

                                <Button Margin="0,0,8,0"
                                        AutomationProperties.Name="{Binding ThemeToggleLabel}"
                                        Command="{Binding ToggleThemeCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="{Binding ThemeToggleLabel}">
                                    <TextBlock Style="{StaticResource IconGlyphStyle}" Text="{Binding ThemeGlyph}" />
                                </Button>

                                <Button AutomationProperties.HelpText="Scan the selected folder without modifying files"
                                        AutomationProperties.Name="Start scan"
                                        Command="{Binding ScanCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0" Style="{StaticResource IconGlyphStyle}" Foreground="#07120E" FontSize="14" Text="&#xE72C;" />
                                    <TextBlock VerticalAlignment="Center" Foreground="#07120E" FontWeight="SemiBold" Text="Scan" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  PanningMode="VerticalOnly">
                        <Grid Margin="28,24,28,30">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- KPI row -->
                            <ItemsControl Grid.Row="0" ItemsSource="{Binding Kpis}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin" Value="0,0,12,0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="132" Style="{StaticResource CardStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Border Width="34"
                                                            Height="34"
                                                            HorizontalAlignment="Left"
                                                            Background="{Binding AccentResourceKey, Converter={StaticResource ResourceKeyToBrushConverter}}"
                                                            CornerRadius="9"
                                                            Opacity="0.20" />
                                                    <TextBlock Width="34"
                                                               Height="34"
                                                               HorizontalAlignment="Left"
                                                               Style="{StaticResource IconGlyphStyle}"
                                                               Foreground="{Binding AccentResourceKey, Converter={StaticResource ResourceKeyToBrushConverter}}"
                                                               Text="{Binding IconGlyph}" />
                                                    <TextBlock Margin="44,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource CardTitleStyle}"
                                                               Text="{Binding Label}" />
                                                </Grid>
                                                <TextBlock Grid.Row="1"
                                                           Margin="0,12,0,5"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource MetricValueStyle}"
                                                           Text="{Binding Value}" />
                                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                    <TextBlock Margin="0,0,4,0"
                                                               Foreground="{Binding AccentResourceKey, Converter={StaticResource ResourceKeyToBrushConverter}}"
                                                               FontFamily="{DynamicResource IconFont}"
                                                               FontSize="10"
                                                               Text="{Binding TrendGlyph}" />
                                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Detail}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Drive health + recovery readiness -->
                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.65*" />
                                    <ColumnDefinition Width="0.85*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Margin="0,0,7,0" Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Drive health" />
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="Actual capacity of the drive containing your selection" />
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource SurfaceHoverBrush}"
                                                    CornerRadius="10"
                                                    Padding="9,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding SystemDrive.HealthResourceKey, Converter={StaticResource ResourceKeyToBrushConverter}}" />
                                                    <TextBlock Foreground="{Binding SystemDrive.HealthResourceKey, Converter={StaticResource ResourceKeyToBrushConverter}}" FontSize="11" FontWeight="SemiBold" Text="{Binding SystemDrive.HealthLabel}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="0,22,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="48" Height="48" Background="{DynamicResource BlueTintBrush}" CornerRadius="12">
                                                    <TextBlock Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource BlueBrush}" FontSize="21" Text="&#xEDA2;" />
                                                </Border>
                                                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding SystemDrive.VolumeLabel}" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}">
                                                        <Run Text="{Binding SystemDrive.FileSystem}" />
                                                        <Run Text="  ·  Local disk" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <TextBlock FontFamily="{DynamicResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Text="{Binding SystemDrive.UsedLabel}" />
                                                <TextBlock Margin="5,4,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Text="used" />
                                                </StackPanel>
                                                <TextBlock Margin="0,3,0,0" HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}">
                                                    <Run Text="{Binding SystemDrive.FreeLabel}" />
                                                    <Run Text="  ·  " />
                                                    <Run Text="{Binding SystemDrive.TotalLabel}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Row="2" Margin="0,18,0,0">
                                            <ProgressBar Value="{Binding SystemDrive.UsedPercentage, Mode=OneWay}" Maximum="100" />
                                            <Grid Margin="0,14,0,0" VerticalAlignment="Top">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource CaptionStyle}" Text="0 GB" />
                                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Text="{Binding SystemDrive.FreeLabel}" />
                                                <TextBlock Grid.Column="2" Style="{StaticResource CaptionStyle}" Text="{Binding SystemDrive.TotalLabel}" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1" Margin="7,0,0,0" Style="{StaticResource RaisedCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Potentially recoverable" />
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="Local engine estimate—always review before acting" />
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right"
                                                       Style="{StaticResource IconGlyphStyle}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="18"
                                                       Text="&#xE73E;" />
                                        </Grid>
                                        <StackPanel Grid.Row="1" Margin="0,17,0,14" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{DynamicResource DisplayFont}" FontSize="34" FontWeight="SemiBold" Text="{Binding RecoverableValue}" />
                                                <TextBlock Margin="6,0,0,4" VerticalAlignment="Bottom" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Text="{Binding RecoverableUnit}" />
                                            </StackPanel>
                                            <ProgressBar Margin="0,12,0,0" Maximum="100" Value="{Binding RecoveryPercentage, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <TextBlock Margin="0,0,7,0" Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Text="&#xE73E;" />
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" Text="{Binding RecoverySummary}" TextTrimming="None" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Distribution + treemap -->
                            <Grid Grid.Row="2" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="1.6*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Margin="0,0,7,0" Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Distribution" />
                                            <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="{Binding DistributionSubtitle}" />
                                        </StackPanel>
                                        <Grid Grid.Row="1" Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="174" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="170" Height="170" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <controls:DonutChart Margin="18" ItemsSource="{Binding StorageCategories}" />
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding HasResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock MaxWidth="92"
                                                               HorizontalAlignment="Center"
                                                               FontFamily="{DynamicResource DisplayFont}"
                                                               FontSize="18"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Center"
                                                               Text="{Binding AnalyzedSizeLabel}" />
                                                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" Text="ANALYZED" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding HasNoResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" Text="NO" />
                                                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" Text="DATA" />
                                                </StackPanel>
                                            </Grid>

                                            <ItemsControl Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding StorageCategories}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="6,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding BrushResourceKey, Converter={StaticResource ResourceKeyToBrushConverter}}" />
                                                            <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Text="{Binding Name}" />
                                                            <TextBlock Grid.Column="2" Margin="12,0,0,0" FontSize="11" FontWeight="SemiBold" Text="{Binding SizeLabel}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1" Margin="7,0,0,0" Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Explore storage" />
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="{Binding TreeSummary}" />
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                                                <Button AutomationProperties.Name="Show storage map"
                                                        Command="{Binding ShowTreemapCommand}"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        Content="Treemap" />
                                                <Button Margin="4,0,0,0"
                                                        AutomationProperties.Name="Show file system tree"
                                                        Command="{Binding ShowTreeCommand}"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        Content="Tree" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="1" Height="190" Margin="-3,15,-3,-3">
                                            <Grid Visibility="{Binding IsTreemapVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.25*" />
                                                    <ColumnDefinition Width="1.6*" />
                                                    <ColumnDefinition Width="0.85*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="1.1*" />
                                                    <RowDefinition Height="0.9*" />
                                                </Grid.RowDefinitions>
                                                <ContentControl Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource TreemapSlotStyle}" Content="{Binding TreemapItems[1], FallbackValue={x:Null}, TargetNullValue={x:Null}}" />
                                                <ContentControl Grid.Column="1" Grid.Row="0" Style="{StaticResource TreemapSlotStyle}" Content="{Binding TreemapItems[0], FallbackValue={x:Null}, TargetNullValue={x:Null}}" />
                                                <ContentControl Grid.Column="1" Grid.Row="1" Style="{StaticResource TreemapSlotStyle}" Content="{Binding TreemapItems[2], FallbackValue={x:Null}, TargetNullValue={x:Null}}" />
                                                <ContentControl Grid.Column="2" Grid.Row="0" Style="{StaticResource TreemapSlotStyle}" Content="{Binding TreemapItems[3], FallbackValue={x:Null}, TargetNullValue={x:Null}}" />
                                                <Grid Grid.Column="2" Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentControl Grid.Column="0" Style="{StaticResource TreemapSlotStyle}" Content="{Binding TreemapItems[4], FallbackValue={x:Null}, TargetNullValue={x:Null}}" />
                                                    <ContentControl Grid.Column="1" Style="{StaticResource TreemapSlotStyle}" Content="{Binding TreemapItems[5], FallbackValue={x:Null}, TargetNullValue={x:Null}}" />
                                                </Grid>
                                            </Grid>
                                            <TreeView Padding="2"
                                                      AutomationProperties.Name="Scanned file tree"
                                                      ItemsSource="{Binding FileTreeRoots}"
                                                      ItemTemplate="{StaticResource FileTreeNodeTemplate}"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                      Visibility="{Binding IsTreeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                                    CornerRadius="10"
                                                    Visibility="{Binding HasNoResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="22" Text="&#xED41;" />
                                                    <TextBlock Margin="0,9,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Text="Choose a folder to generate the treemap and file tree" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Insight cards -->
                            <Grid Grid.Row="3" Margin="0,22,0,10" Visibility="{Binding HasResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Insights for you" />
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" Text="Ranked by impact and risk" />
                            </Grid>

                            <ItemsControl Grid.Row="4" ItemsSource="{Binding Insights}" Visibility="{Binding HasResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin" Value="0,0,12,0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="164" Style="{StaticResource RaisedCardStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Border Width="38"
                                                            Height="38"
                                                            HorizontalAlignment="Left"
                                                            Background="{Binding BrushResourceKey, Converter={StaticResource ResourceKeyToBrushConverter}}"
                                                            CornerRadius="10"
                                                            Opacity="0.18" />
                                                    <TextBlock Width="38"
                                                               Height="38"
                                                               HorizontalAlignment="Left"
                                                               Style="{StaticResource IconGlyphStyle}"
                                                               Foreground="{Binding BrushResourceKey, Converter={StaticResource ResourceKeyToBrushConverter}}"
                                                               Text="{Binding IconGlyph}" />
                                                    <StackPanel Margin="50,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Foreground="{Binding BrushResourceKey, Converter={StaticResource ResourceKeyToBrushConverter}}" FontSize="9" FontWeight="Bold" Text="{Binding Eyebrow}" />
                                                        <TextBlock Margin="0,3,0,0" FontSize="14" FontWeight="SemiBold" Text="{Binding Title}" />
                                                    </StackPanel>
                                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{DynamicResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Text="{Binding Value}" />
                                                </Grid>
                                                <TextBlock Grid.Row="1"
                                                           Margin="0,13,0,13"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="11"
                                                           Text="{Binding Description}"
                                                           TextTrimming="None"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="2"
                                                           HorizontalAlignment="Left"
                                                           Foreground="{Binding BrushResourceKey, Converter={StaticResource ResourceKeyToBrushConverter}}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding ActionLabel}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Files and activity -->
                            <Grid Grid.Row="5" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.85*" />
                                    <ColumnDefinition Width="0.75*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Margin="0,0,7,0" Padding="0" Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Margin="20,18,20,10">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Largest files" />
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="{Binding ResultCountLabel}" />
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                                <Button Margin="0,0,6,0"
                                                        AutomationProperties.Name="Filters coming soon"
                                                        IsEnabled="False"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        ToolTip="Advanced filters coming soon"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        Content="Filters" />
                                                <Button AutomationProperties.Name="Full view coming soon"
                                                        IsEnabled="False"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        ToolTip="Full view coming soon"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        Content="View all  →" />
                                            </StackPanel>
                                        </Grid>

                                        <DataGrid Grid.Row="1"
                                                  Height="318"
                                                  AutomationProperties.Name="Largest files list"
                                                  ItemsSource="{Binding LargeFilesView}">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Width="2.2*" Header="NAME AND PATH" SortMemberPath="Name">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="26" Height="26" Background="{DynamicResource BlueTintBrush}" CornerRadius="7">
                                                                    <TextBlock Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource BlueBrush}" FontSize="12" Text="&#xE8A5;" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding Name}" />
                                                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionStyle}" FontSize="10" Text="{Binding Path}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Width="0.75*" Binding="{Binding Category}" Header="TYPE" SortMemberPath="Category">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Setter Property="FontSize" Value="11" />
                                                            <Setter Property="VerticalAlignment" Value="Center" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Width="0.62*" Binding="{Binding SizeBytes, Converter={StaticResource BytesToReadableSizeConverter}}" Header="SIZE" SortMemberPath="SizeBytes">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontSize" Value="11" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="VerticalAlignment" Value="Center" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Width="0.62*" Binding="{Binding ModifiedLabel}" Header="MODIFIED" SortMemberPath="ModifiedAtUtc">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Setter Property="FontSize" Value="10" />
                                                            <Setter Property="VerticalAlignment" Value="Center" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTemplateColumn Width="0.74*" Header="STATUS" SortMemberPath="Risk">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border HorizontalAlignment="Left"
                                                                    Padding="8,4"
                                                                    Background="{Binding RiskTintResourceKey, Converter={StaticResource ResourceKeyToBrushConverter}}"
                                                                    CornerRadius="9">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Ellipse Width="5" Height="5" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding RiskBrushResourceKey, Converter={StaticResource ResourceKeyToBrushConverter}}" />
                                                                    <TextBlock Foreground="{Binding RiskBrushResourceKey, Converter={StaticResource ResourceKeyToBrushConverter}}" FontSize="10" FontWeight="SemiBold" Text="{Binding RiskLabel}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <Grid Grid.Column="1" Margin="7,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Style="{StaticResource RaisedCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Scan status" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="{Binding ScanStatus}" />
                                                </StackPanel>
                                                <Border Width="36" Height="36" HorizontalAlignment="Right" Background="{DynamicResource AccentTintBrush}" CornerRadius="10">
                                                    <TextBlock Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource AccentBrush}" Text="&#xE72C;" />
                                                </Border>
                                            </Grid>
                                            <Grid Grid.Row="1" Margin="0,18,0,0">
                                            <ProgressBar Height="8"
                                                         Maximum="100"
                                                         Value="{Binding ScanProgress, Mode=OneWay}"
                                                         IsIndeterminate="{Binding IsScanIndeterminate, Mode=OneWay}" />
                                                <TextBlock Margin="0,13,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="SemiBold" Text="{Binding ScanProgressLabel}" />
                                            </Grid>
                                            <TextBlock Grid.Row="2" Margin="0,16,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Text="{Binding ScanDetail}" TextTrimming="None" TextWrapping="Wrap" />
                                            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                                <Border Padding="9,7"
                                                        Background="{DynamicResource RedTintBrush}"
                                                        CornerRadius="7"
                                                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Foreground="{DynamicResource RedBrush}" FontSize="10" Text="{Binding ErrorMessage}" TextTrimming="None" TextWrapping="Wrap" />
                                                </Border>
                                                <Border Margin="0,5,0,0"
                                                        Padding="9,7"
                                                        Background="{DynamicResource AmberTintBrush}"
                                                        CornerRadius="7"
                                                        Visibility="{Binding HasIssues, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Foreground="{DynamicResource AmberBrush}" FontSize="10" Text="{Binding IssueSummary}" TextTrimming="None" TextWrapping="Wrap" />
                                                </Border>
                                            </StackPanel>
                                            <WrapPanel Grid.Row="4" Margin="0,14,0,0">
                                                <Button Margin="0,0,7,0"
                                                        AutomationProperties.Name="Choose folder"
                                                        Command="{Binding BrowseFolderCommand}"
                                                        Content="Folder…" />
                                                <Button AutomationProperties.Name="Start a real read-only scan"
                                                        Command="{Binding ScanCommand}"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Content="Scan now" />
                                                <Button Margin="8,0,0,0"
                                                        AutomationProperties.Name="Stop scan"
                                                        Command="{Binding CancelScanCommand}"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Content="Stop"
                                                        Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Recent activity" />
                                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" Text="Current session" />
                                            </Grid>
                                            <ItemsControl Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding RecentActivities}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,7">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="28"
                                                                    Height="28"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    Background="{Binding BrushResourceKey, Converter={StaticResource ResourceKeyToBrushConverter}}"
                                                                    CornerRadius="8"
                                                                    Opacity="0.18" />
                                                            <TextBlock Width="28"
                                                                       Height="28"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Top"
                                                                       Style="{StaticResource IconGlyphStyle}"
                                                                       Foreground="{Binding BrushResourceKey, Converter={StaticResource ResourceKeyToBrushConverter}}"
                                                                       FontSize="12"
                                                                       Text="{Binding IconGlyph}" />
                                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding Title}" />
                                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionStyle}" FontSize="10" Text="{Binding Detail}" />
                                                                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" Text="{Binding TimeLabel}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Grid.Row="1"
                                                       Margin="0,20,0,0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="10"
                                                       Text="No activity in this session"
                                                       Visibility="{Binding HasNoResults, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <Border Grid.Row="6"
                                    Margin="0,16,0,0"
                                    Padding="14,10"
                                    Background="{DynamicResource AccentTintBrush}"
                                    CornerRadius="10">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Margin="0,0,8,0" Style="{StaticResource IconGlyphStyle}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Text="&#xE73E;" />
                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Text="SoFresh only analyzes files: this version does not provide move or delete operations." />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
